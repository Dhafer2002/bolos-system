# انسخ هذا الملف باسم .env وعبّي القيم (لا ترفع .env على GitHub)
# على Vercel: حط نفس القيم في Project Settings → Environment Variables

# مفتاح IFTTT الجديد — ولّد مفتاح جديد من IFTTT لأن القديم انكشف
IFTTT_KEY=

# الرقم السري لدخول الموظفين (تشغيل/إيقاف الطاولات)
STAFF_PIN=

# كلمة مرور الإدارة (مسح البيانات) — خلها مختلفة عن رقم الموظفين
ADMIN_PASSWORD=

# قاعدة البيانات (لازم على Vercel — بدونها يُحفظ في data/ على جهازك)
# SUPABASE_SECRET_KEY من Supabase → Project Settings → API Keys → Secret key
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# اختياري
# SESSION_SECRET=   نص عشوائي طويل لتوقيع دخول الموظفين
PORT=3000
# DATA_DIR=./data
